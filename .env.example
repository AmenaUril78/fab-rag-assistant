# Copy to .env and fill in.

# Which knowledge base the app opens with: fab | it | private (your own docs in data/private/)
FABRAG_PROFILE=fab

# --- Option A: fully local and free with Ollama (recommended for work documents) ---
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2

# --- Option B: hosted API (comment out Option A) ---
# LLM_PROVIDER=anthropic          # or openai
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# --- Option C: no language model, cited passages only ---
# LLM_PROVIDER=none

# Embeddings: minilm (free, local) | openai | hashing (offline tests)
EMBEDDING_PROVIDER=minilm

# Retrieval: hybrid | vector | bm25
RETRIEVAL_MODE=hybrid
TOP_K=4
